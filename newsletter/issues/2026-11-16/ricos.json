        "italicData": true
       }
      ]
     }
    },
    {
     "type": "TEXT",
     "nodes": [],
     "textData": {
      "text": "The Loadstar",
      "decorations": [
       {
        "type": "ITALIC",
        "italicData": true
       },
       {
        "type": "LINK",
        "linkData": {
         "link": {
