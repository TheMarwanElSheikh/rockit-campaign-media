     "textData": {
      "text": "Rockit explains: ACID in 90 seconds",
      "decorations": []
     }
    }
   ],
   "headingData": {
    "level": 2
   }
  },
  {
   "type": "PARAGRAPH",
   "nodes": [
    {
     "type": "TEXT",
     "nodes": [],
     "textData": {
      "text": "Every sea shipment into Egypt needs an ACID number from Nafeza before it ships, and since 1 January 2026 so does air cargo. The foreign exporter files the documents through a verified CargoX account; the importer cannot do it for them. The ACID then has to appear on the invoice, the packing list and the bill of lading (for air, in the OCI field of the e-AWB). Missing or mismatched ACIDs are among the most avoidable reasons cargo gets held. Our guide covers each step. ",
      "decorations": []
     }
    },
    {
     "type": "TEXT",
     "nodes": [],
     "textData": {
      "text": "Read the ACID guide",
      "decorations": [
       {
        "type": "BOLD",
        "fontWeightValue": 700
       },
       {
        "type": "LINK",
        "linkData": {
         "link": {
          "url": "https://www.rockit-transport.com/post/acid-number-egypt-guide",
          "target": "BLANK",
          "rel": {
           "noreferrer": true
          }
         }
        }
       }
      ]
     }
    }
   ],
   "paragraphData": {}
