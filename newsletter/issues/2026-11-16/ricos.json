  {
   "type": "HEADING",
   "nodes": [
    {
     "type": "TEXT",
     "nodes": [],
     "textData": {
      "text": "Clear before the delivery order. Use it.",
      "decorations": []
     }
    }
   ],
   "headingData": {
    "level": 3
   }
  },
  {
   "type": "PARAGRAPH",
   "nodes": [
    {
     "type": "TEXT",
     "nodes": [],
     "textData": {
      "text": "Minister of Finance Decree 262/2026 amended the customs executive regulations: a customs declaration can now be lodged and processed before the delivery order is issued, provided the D/O is presented before final release. The exception is a \"To Order\" bill of lading, which still needs the D/O when the declaration is opened. On a tight free-time window, filing early can decide whether you clear inside free time or pay demurrage. Send us documents with the pre-alert, not on arrival.",
      "decorations": []
     }
    }
   ],
   "paragraphData": {}
  },
